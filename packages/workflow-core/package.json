{
    "name": "or3-workflow-core",
    "version": "0.1.4",
    "description": "Headless workflow engine with LLM agent orchestration",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "sideEffects": false,
    "files": [
        "dist"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./openrouter-agent": {
            "types": "./dist/openrouter-agent.d.ts",
            "import": "./dist/openrouter-agent.js"
        }
    },
    "scripts": {
        "build": "vite build",
        "dev": "vite build --watch",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "prepublishOnly": "bun run build"
    },
    "publishConfig": {
        "access": "public"
    },
    "keywords": [
        "workflow",
        "ai",
        "agent",
        "llm",
        "orchestration",
        "openrouter"
    ],
    "author": "Brendon",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Saluana/or3-workflows.git",
        "directory": "packages/workflow-core"
    },
    "dependencies": {
        "@openrouter/sdk": "^1.1.6",
        "ajv": "^8.17.1",
        "zod": "^4.0.0"
    },
    "peerDependencies": {
        "@openrouter/agent": "^0.8.0",
        "@opentelemetry/api": ">=1.0.0"
    },
    "peerDependenciesMeta": {
        "@openrouter/agent": {
            "optional": true
        },
        "@opentelemetry/api": {
            "optional": true
        }
    },
    "devDependencies": {
        "typescript": "^5.0.0",
        "vite": "^8.1.5",
        "vite-plugin-dts": "^5.0.3",
        "vitest": "^4.1.10"
    }
}
