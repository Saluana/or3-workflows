{
    "name": "or3-workflows-monorepo",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "workspaces": [
        "packages/*",
        "demo-v2",
        "demo-headless"
    ],
    "scripts": {
        "dev": "bun run --filter demo-v2 dev",
        "build": "bun run --filter './packages/*' build",
        "build:core": "cd packages/workflow-core && bun run build",
        "build:vue": "cd packages/workflow-vue && bun run build",
        "preview": "bun run --filter demo-v2 preview",
        "test": "vitest run",
        "typecheck": "tsc -b"
    },
    "devDependencies": {
        "@types/node": "^24.10.1",
        "typescript": "^5.0.0",
        "vite": "^8.1.5",
        "vitest": "^4.1.10"
    },
    "dependencies": {
        "@openrouter/sdk": "^0.3.11"
    },
    "packageManager": "bun@1.3.14",
    "engines": {
        "node": ">=20"
    }
}
