{
    "name": "or3-workflows-monorepo",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "workspaces": [
        "packages/*",
        "demo-v2",
        "demo-headless"
    ],
    "scripts": {
        "dev": "bun run --filter demo-v2 dev",
        "build": "bun run --filter './packages/*' build",
        "build:core": "cd packages/workflow-core && bun run build",
        "build:vue": "cd packages/workflow-vue && bun run build",
        "preview": "bun run --filter demo-v2 preview",
        "test": "vitest run",
        "test:live:openrouter": "vitest run packages/workflow-core/src/__tests__/openrouter-live.test.ts packages/workflow-core/src/__tests__/openrouter-complex-live.test.ts packages/workflow-core/src/__tests__/openrouter-cache-live.test.ts --reporter=verbose",
        "test:live:openrouter:longform": "vitest run demo-headless/src/__tests__/longform-books.openrouter-live.test.ts --reporter=verbose",
        "typecheck": "tsc -b"
    },
    "devDependencies": {
        "@openrouter/agent": "^0.8.0",
        "@types/node": "^24.10.1",
        "typescript": "^5.0.0",
        "vite": "^8.1.5",
        "vitest": "^4.1.10"
    },
    "dependencies": {
        "@openrouter/sdk": "^1.1.6"
    },
    "packageManager": "bun@1.3.14",
    "engines": {
        "node": ">=24"
    }
}
